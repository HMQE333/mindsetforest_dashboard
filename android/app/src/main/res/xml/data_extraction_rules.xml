<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or moved to a new phone: tokens are bound to this phone's keystore. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
