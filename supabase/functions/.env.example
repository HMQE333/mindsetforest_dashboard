# Secrets for MindsetForest Supabase Edge Functions.
# Set these on your Supabase project — DO NOT commit real values.
#
#   supabase secrets set --env-file supabase/functions/.env
#
# (copy this file to supabase/functions/.env, fill in real keys, then run the command above)

# OpenRouter — used for every AI feature, including the Archive / Forest vector
# embeddings (ai-embed-block, forest-publish-seed: openai/text-embedding-3-small).
OPENROUTER_API_KEY=sk-or-...

# Optional: override the OpenRouter model. Default is google/gemini-2.5-flash —
# cheap, ~1M-token context, strong at digesting large / abstract text.
# Other good cheap options: google/gemini-2.0-flash-001, deepseek/deepseek-chat
OPENROUTER_MODEL=google/gemini-2.5-flash
